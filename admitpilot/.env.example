# ========================================================
# AdmitPilot AI — Environment Configuration
# ========================================================

# Server Port
PORT=3001

# AI Model Provider Credentials
# 1. Google Gemini (Recommended — fast, structured output, free tier available)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Ollama Local Server (Optional — 100% private self-hosted inference)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3

# 3. OpenRouter API (Optional — access GPT-4o, Claude, Gemini, DeepSeek & free models via sk-or-v1-...)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 4. DeepSeek API (Optional — paid API)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 5. OpenAI or Compatible Gateway (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ENDPOINT=https://api.openai.com/v1

# Auth Secret (Required — 32+ characters)
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars

# Supabase Postgres Configuration (Optional for cloud DB; falls back to local file store automatically)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL="postgresql://postgres:[YOUR-DATABASE-PASSWORD]@db.your-project.supabase.co:5432/postgres"
PGHOST=db.your-project.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=your_database_password

